{
  "opencollection": "1.0.0",
  "info": {
    "name": "Finnhub Company News API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Company News",
        "type": "folder"
      },
      "items": [
        {
          "info": {
